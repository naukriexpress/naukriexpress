# Public site URL - used for SEO tags, sitemap, JSON-LD
NEXT_PUBLIC_SITE_URL=https://naukriexpress.space

# Admin credentials (demo store). Change these before deploying.
ADMIN_USERNAME=admin
# If set, overrides the built-in demo password hash for "BgiAdmin@123".
# Generate with: node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
# ADMIN_PASSWORD_HASH=

# Secret used to sign admin session cookies - set a long random string in production.
ADMIN_SESSION_SECRET=change-this-to-a-long-random-string-in-production

# PostgreSQL/Supabase connection string. Leave unset to use the local
# data/jobs.json file instead (fine for local testing, but jobs won't
# persist on serverless hosts like Vercel without this set).
# Get this from Supabase: Project Settings > Database > Connection string
# DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres
