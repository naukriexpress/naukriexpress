# Public site URL - used for SEO tags, sitemap, JSON-LD
NEXT_PUBLIC_SITE_URL=https://www.naukriexpress.space

# Required for production admin login. Set these in Vercel Environment Variables.
ADMIN_USERNAME=replace-with-a-unique-admin-username
# Generate a bcrypt hash with:
# node -e "console.log(require('bcryptjs').hashSync('YOUR-STRONG-PASSWORD', 12))"
ADMIN_PASSWORD_HASH=replace-with-generated-bcrypt-hash
# Generate a random secret with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters; never use this example value in production.
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
# After changing these Vercel variables, redeploy the project for changes to apply.

# PostgreSQL/Supabase connection string. Leave unset only for local JSON development.
# Get this from Supabase: Project Settings > Database > Connection string
# DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres
