# Public site URL - used for SEO tags, sitemap, and JSON-LD
NEXT_PUBLIC_SITE_URL=https://www.naukriexpress.space

# Required in production. Use a unique admin username.
ADMIN_USERNAME=change-this-admin-username
# Generate a bcrypt hash for a strong password:
# node -e "console.log(require('bcryptjs').hashSync('YOUR_STRONG_PASSWORD', 12))"
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash
# Set a unique random string of at least 32 characters. Example generation:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=replace-with-random-48-byte-secret

# PostgreSQL/Supabase connection string. Leave unset to use local JSON data
# during local development only. Production Vercel needs DATABASE_URL.
# DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres
